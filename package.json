{
  "name": "klanex-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/Node SDK for klanex \u2014 the tool orchestration engine for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrassy/klanex-js.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents.d.ts",
      "import": "./dist/openai-agents.js",
      "require": "./dist/openai-agents.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/ai.ts src/openai-agents.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "sideEffects": false,
  "keywords": [
    "agents",
    "ai-agents",
    "ai-sdk",
    "klanex",
    "llm",
    "openai-agents",
    "orchestration",
    "tool-use",
    "vercel-ai-sdk",
    "webhooks"
  ],
  "peerDependencies": {
    "ai": ">=5.0.0",
    "@openai/agents": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openai/agents": "^0.18.0",
    "@types/node": "^26.1.0",
    "ai": "^7.0.106",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "zod": "^4.6.5"
  }
}
